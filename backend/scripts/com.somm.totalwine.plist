<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.somm.totalwine</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/danielguerrero/dev/wine_app/backend/scripts/run_totalwine_launchd.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/danielguerrero/dev/wine_app/backend</string>

    <!-- Every 10 days (864000s). StartInterval rather than StartCalendarInterval
         because "every 10 days" has no calendar expression. Total Wine is
         PerimeterX-blocked (item 46); this is a canary probe, not a scrape, so a
         blocked cycle costs exactly one request. 10 days rather than monthly gives
         ~3x the signal on when the block lifts at negligible added risk — a single
         normal-UA GET is not what sustains a block earned by hundreds of rapid
         pageSize=200 fetches. Every result is appended to
         ~/Library/Logs/somm-totalwine-probes.tsv so the decay curve becomes
         measurable instead of guessed. -->
    <key>StartInterval</key>
    <integer>864000</integer>

    <key>StandardOutPath</key>
    <string>/Users/danielguerrero/Library/Logs/somm-totalwine.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/danielguerrero/Library/Logs/somm-totalwine.err.log</string>

    <key>RunAtLoad</key>
    <false/>
    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <true/>
</dict>
</plist>
